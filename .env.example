# ─────────────────────────────────────────────
# ScopeWise — Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env and adjust if needed.
# NEVER commit .env to version control.

# Ollama local LLM configuration
# Ollama must be running locally with the Llama 3 model pulled.
# Install: https://ollama.com  |  Pull model: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3
